# ============================================
# AI Life Assistant — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ── Database (PostgreSQL) ───────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_life_assistant
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── AI Providers ────────────────────────────
# Gemini: chat, embeddings, task extraction
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Groq: voice (Whisper STT + Orpheus TTS)
GROQ_API_KEY=gsk_your-groq-key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# ── AWS (S3, etc.) ──────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=ai-life-assistant-uploads

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ─────────────────────────────────
LOG_LEVEL=debug

# ── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
